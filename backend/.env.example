# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git — it is already in .gitignore.

# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to call
GEMINI_MODEL=gemini-3.5-flash

# Port the server listens on (App Runner/Elastic Beanstalk will inject PORT too)
PORT=8080

# Comma-separated list of allowed origins for CORS in production
# e.g. https://your-app-url.awsapprunner.com
ALLOWED_ORIGINS=*
